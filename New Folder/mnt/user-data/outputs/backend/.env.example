# ---- App ----
PROJECT_NAME=ShopFast API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# ---- Database (PostgreSQL) ----
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://shopfast:shopfast@localhost:5432/shopfast

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER commit the real value. Rotate it if it ever leaks.
SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed frontend origins. Never use "*" with credentials.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
