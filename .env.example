# Copy to .env in the same folder as docker-compose.yml, then fill in SECRET_KEY.
# Compose reads this file automatically.

# ---- Database ----
POSTGRES_USER=shopfast
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=shopfast

# ---- Backend ----
ENVIRONMENT=development

# REQUIRED. The API refuses to start without a strong value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origins allowed to call the API. Port 3000 is the dockerized frontend,
# 5173 is `npm run dev` running outside Docker.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend (baked in at build time) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GA4_MEASUREMENT_ID=
VITE_FB_PIXEL_ID=
